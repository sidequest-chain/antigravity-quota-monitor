{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Quota Monitor",
  "version": "0.1.0",
  "identifier": "io.github.sidequest-chain.antigravity-quota-monitor",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Quota Monitor",
        "width": 340,
        "height": 430,
        "minWidth": 260,
        "minHeight": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
